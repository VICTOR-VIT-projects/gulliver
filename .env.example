QLOO_API_KEY=
OPENROUTER_API_KEY=
# Primary model, then fallbacks in order (tried when a model is down or rate-limited)
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_FALLBACKS=google/gemma-4-26b-a4b-it:free,nvidia/nemotron-3.5-lightning
# Supabase (Project Settings → API). The anon/publishable key is safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
